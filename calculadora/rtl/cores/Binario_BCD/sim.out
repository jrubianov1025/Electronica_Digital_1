    %vpi_call 2 244 "$display", "Op_A FINAL = %024b", v0x237d9020_0 {0 0 0};
    %vpi_call 2 246 "$display", "=========================================================" {0 0 0};
    %delay 20000, 0;
    %vpi_call 2 250 "$finish" {0 0 0};
